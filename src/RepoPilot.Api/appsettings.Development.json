{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Relative to the project directory, which is where `dotnet run --project
  // src/RepoPilot.Api` puts the working directory. Without these, the defaults
  // in WorkspaceOptions resolve to src/RepoPilot.Api/evals/fixtures and
  // registration fails with "no fixture directory" — which reads as a missing
  // fixture rather than as a path resolved from somewhere unexpected.
  //
  // Development only. A deployment sets absolute paths; it has no reason to
  // inherit this repository's layout.
  "RepoPilot": {
    "Workspace": {
      "Root": "../../.workspace",
      "FixturesRoot": "../../evals/fixtures"
    },
    "Evaluation": {
      "TasksDirectory": "../../evals/tasks",
      "ResultsDirectory": "../../evals/results"
    }
  }
}
