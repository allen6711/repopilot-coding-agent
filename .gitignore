# ---------- Secrets & local config ----------
.env
.env.*
!.env.example

# The adversarial fixture's .env is test data, not a credential. It has to be
# committed: the indexer's secret exclusion is checked against it, and a file the
# repository refuses to carry cannot be the thing that test reads (FR-025a,
# SC-014).
!evals/fixtures/adversarial-content/config/.env
appsettings.Local.json
**/appsettings.*.Local.json
secrets.json
*.pem
*.key
*.pfx

# ---------- Agent sandbox / disposable workspaces ----------
# Patches are applied to throwaway working copies; never commit them.
sandbox/workspaces/
sandbox/tmp/
.repopilot/

# ---------- Evaluation output ----------
# Commit fixtures, tasks, and summarized results.
# Ignore raw per-run dumps and traces.
evals/results/raw/
evals/results/**/*.jsonl
evals/results/**/*.trace.json

# ---------- Disposable run working copies ----------
# FR-024a: every run gets a working copy under the workspace root. These are
# destroyed at terminal outcome (FR-026a) and must never be committed.
.workspace/

# ---------- Local data volumes ----------
.postgres-data/
.pgdata/
.redis-data/

# ---------- OS / editors ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
