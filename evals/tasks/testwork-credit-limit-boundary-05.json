  "successCondition": {
    "type": "output_matches",
    "pattern": "Failed:\\s+0,\\s+Passed:\\s+(?:[3-9]|\\d{2,}),"
  },
  "expectedChangedFiles": [
    "tests/Billing.Tests/CreditLimitTests.cs"
  ],
  "referencePatch": "_reference/testwork-credit-limit-boundary-05.md"
