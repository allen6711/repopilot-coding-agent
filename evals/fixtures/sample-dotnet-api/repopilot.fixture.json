{
  "$schema": "https://repopilot.dev/schemas/fixture-config.schema.json",
  "slug": "sample-dotnet-api",
  "displayName": "Sample Orders Service",
  "description": "Small .NET library used as an evaluation fixture. Carries a deliberate defect, a missing check, or an untidy implementation per evaluation task. Each task has its own command so that one task's outstanding defect never decides another task's result — the suite as a whole is never green by design, and a whole-suite command would grade every task against every other task's state.",
  "sandbox": {
    "image": "repopilot/fixture-dotnet:1",
    "workdir": "/workspace",
    "timeoutSeconds": 300,
    "memoryMegabytes": 2048,
    "cpuCount": 2,
    "pidsLimit": 256
  },
  "commands": [
    {
      "name": "unit",
      "argv": [
        "dotnet",
        "test",
        "tests/Orders.Tests/Orders.Tests.csproj",
        "--filter",
        "FullyQualifiedName~OrderLookupServiceTests"
      ],
      "purpose": "verify"
    },
