      "name": "unit-proration",
      "argv": [
        "dotnet",
        "test",
        "tests/Billing.Tests/Billing.Tests.csproj",
        "--filter",
        "FullyQualifiedName~ProrationCalculatorTests"
      ],
      "purpose": "verify"
    },
