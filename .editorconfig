root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,ts,tsx,js,jsx,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4

# Language conventions
csharp_style_namespace_declarations = file_scoped:error
csharp_prefer_braces = true:warning
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
csharp_style_prefer_primary_constructors = true:suggestion

# Nullability and correctness are errors, not suggestions. The governance
# primitives in Domain deal with untrusted paths and untrusted model output;
# a nullable warning there is a real defect.
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8604.severity = error
dotnet_diagnostic.CS8618.severity = error
dotnet_diagnostic.CS8625.severity = error

# Async correctness
dotnet_diagnostic.CS4014.severity = error
dotnet_diagnostic.CA2007.severity = none

# Unused usings and members
dotnet_diagnostic.IDE0005.severity = warning

[tests/**/*.cs]
# Test projects may leave fields unassigned in fixtures.
dotnet_diagnostic.CS8618.severity = warning
