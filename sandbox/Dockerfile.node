# Sandbox image for Node/TypeScript repository fixtures.
# See Dockerfile.dotnet for the isolation contract — identical here.

FROM node:22-bookworm-slim

# The sandbox runs as UID 1000 -- DockerSandboxRunner passes User="1000:1000"
# unconditionally, so the image must have a usable home for that UID. Several
# official base images already ship a user there (the SDK image, node), so
# creating one blindly fails the build. Adopt whoever holds it, or create one.
RUN if id -u 1000 >/dev/null 2>&1; then \
        existing="$(id -un 1000)"; \
    else \
        useradd --uid 1000 --create-home --shell /bin/bash runner; \
        existing=runner; \
    fi && \
    mkdir -p /home/runner && \
    chown -R 1000:1000 /home/runner && \
    usermod --home /home/runner "$existing"

# Pre-populate the store so `pnpm install --offline` succeeds with no network.
COPY sandbox/node-warmup/ /tmp/warmup/
RUN corepack enable && \
    if [ -f /tmp/warmup/package.json ]; then \
        cd /tmp/warmup && pnpm config set store-dir /home/runner/.pnpm-store && \
        pnpm install --prod=false; \
    fi && \
    chown -R runner:runner /home/runner && \
    rm -rf /tmp/warmup

ENV PNPM_HOME=/home/runner/.pnpm \
    npm_config_store_dir=/home/runner/.pnpm-store

USER 1000:1000
WORKDIR /workspace
