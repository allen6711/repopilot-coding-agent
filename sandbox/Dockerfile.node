# Sandbox image for Node/TypeScript repository fixtures.
# See Dockerfile.dotnet for the isolation contract — identical here.

FROM node:22-bookworm-slim

RUN useradd --uid 1000 --create-home --shell /bin/bash runner

# Pre-populate the store so `pnpm install --offline` succeeds with no network.
COPY sandbox/node-warmup/ /tmp/warmup/
RUN corepack enable && \
    if [ -f /tmp/warmup/package.json ]; then \
        cd /tmp/warmup && pnpm config set store-dir /home/runner/.pnpm-store && \
        pnpm install --prod=false; \
    fi && \
    chown -R runner:runner /home/runner && \
    rm -rf /tmp/warmup

ENV PNPM_HOME=/home/runner/.pnpm \
    npm_config_store_dir=/home/runner/.pnpm-store

USER runner
WORKDIR /workspace
