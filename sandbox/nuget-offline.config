<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restore inside the sandbox resolves only from the package cache baked into
    the image. Every remote source is cleared, so a package that was not warmed
    at build time fails restore immediately instead of hanging on a network that
    is not there (Principle II: the container runs with no network at all).

    Restore still has to run: warming the global package cache does not produce
    a project's obj/project.assets.json, and that file is per-project and lives
    in the run's working copy, which is created fresh for every run. A restore
    against this config is a local file operation.
  -->

  <packageSources>
    <clear />
  </packageSources>

  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>

</configuration>
