<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\RepoPilot.Api\RepoPilot.Api.csproj" />
  </ItemGroup>

  <!--
    Shared with the integration suite by link rather than by a project
    reference. The Docker probe and the PostgreSQL fixture are harness
    plumbing, and one test project depending on another's assembly would make
    a change to an integration test able to break the e2e build.
  -->
  <ItemGroup>
    <Compile
      Include="..\..\integration\RepoPilot.IntegrationTests\Infrastructure\*.cs"
      Link="Infrastructure\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>